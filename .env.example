# AgentGuardian — example development environment file
#
# Copy this to `.env` (which is gitignored) and fill in real values
# for local development. AgentGuardian's CLI auto-loads `.env` from the
# current working directory at startup IF python-dotenv is installed
# (it's in the `dev` extra: `uv sync --extra dev`).
#
# Production users should use real environment variables instead:
#   export GEMINI_API_KEY=AIzaSy...
#   agent-guardian scan ...
#
# All three precedence chains work:
#   AGENT_GUARDIAN_<PROVIDER>_API_KEY   (namespaced, highest precedence)
#   OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY / GOOGLE_API_KEY
#       (standard provider env vars, fallback)
#   <unset>                              (use --model stub for testing)

# Google Gemini (AI Studio API key — get one at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=

# Optional: namespaced overrides (these win over the standard vars above)
# AGENT_GUARDIAN_GEMINI_API_KEY=
# AGENT_GUARDIAN_OPENAI_API_KEY=
# AGENT_GUARDIAN_ANTHROPIC_API_KEY=

# Optional: signing secret (M13). Defaults to a public dev secret if unset.
# AGENT_GUARDIAN_SIGNING_SECRET=
