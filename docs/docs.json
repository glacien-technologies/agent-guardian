{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AgentGuardian",
  "description": "Open-source adversarial-swarm framework for red-teaming LLM agents. Find prompt-injection, tool-abuse and RAG-poisoning vulnerabilities before production.",
  "colors": {
    "primary": "#8B5CF6",
    "light": "#A78BFA",
    "dark": "#7C3AED"
  },
  "favicon": "/images/favicon.svg",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://agentguardian.io"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "boost": 2,
        "pages": [
          "index",
          "quickstart",
          "installation",
          "first-scan"
        ]
      },
      {
        "group": "Concepts",
        "icon": "compass",
        "pages": [
          "how-it-works",
          "concepts/aivss",
          "concepts/swarm",
          "concepts/scan-modes",
          "concepts/evidence-packs"
        ]
      },
      {
        "group": "Attack library",
        "icon": "shield-alert",
        "pages": [
          "attacks/overview",
          "attacks/prompt-injection",
          "attacks/tool-abuse",
          "attacks/rag-poisoning"
        ]
      },
      {
        "group": "Reports",
        "icon": "file-text",
        "pages": [
          "reports/overview",
          "reports/signatures",
          "reports/owasp-mapping"
        ]
      },
      {
        "group": "CI/CD",
        "icon": "git-branch",
        "pages": [
          "ci/github-actions",
          "ci/gitlab",
          "ci-cd/security-gates",
          "ci-cd/fail-builds-on-critical-findings"
        ]
      },
      {
        "group": "Examples",
        "icon": "code",
        "pages": [
          "examples/langgraph-agent",
          "examples/crewai-agent",
          "examples/openai-agents",
          "examples/mcp-server"
        ]
      },
      {
        "group": "Build with AgentGuardian",
        "icon": "wrench",
        "pages": [
          "build-with/write-a-probe",
          "build-with/write-an-adapter"
        ]
      },
      {
        "group": "Architecture",
        "icon": "layers",
        "pages": [
          "architecture/system-overview",
          "architecture/live-dashboard",
          "architecture/observability"
        ]
      },
      {
        "group": "Reference",
        "icon": "book",
        "pages": [
          "reference/cli",
          "reference/python-sdk",
          "reference/config",
          "reference/error-codes",
          "reference/report-schema"
        ]
      },
      {
        "group": "Community",
        "icon": "users",
        "pages": [
          "contributing"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/glacien-technologies/agent-guardian",
          "icon": "github"
        },
        {
          "anchor": "PyPI",
          "href": "https://pypi.org/project/agent-guardian/",
          "icon": "package"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Changelog",
        "href": "https://github.com/glacien-technologies/agent-guardian/blob/main/CHANGELOG.md"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/glacien-technologies/agent-guardian"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "mcp", "cursor"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/glacien-technologies/agent-guardian"
    }
  },
  "search": {
    "prompt": "Search the AgentGuardian docs..."
  }
}
